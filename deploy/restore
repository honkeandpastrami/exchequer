#!/bin/sh
# restore: replace the Exchequer database with a backup dump (design §14.2).
#
#   deploy/restore FILE
#
# Stops the API, restores FILE with the backup image (`exchequer-backup
# restore --replace`, which checks FILE before dropping anything), and starts
# the API again. Uses the unit, network, container and secret names from
# deploy/examples/. On failure the API is left stopped.

set -eu

die() {
    echo "restore: $*" >&2
    exit 1
}

[ "$#" -eq 1 ] || die "usage: deploy/restore FILE"
[ -f "$1" ] || die "$1 not found"
dir=$(cd "$(dirname "$1")" && pwd)
name=$(basename "$1")

max=$(podman run --rm localhost/exchequer-server:latest schema-version)

systemctl --user stop exchequer-api.service
if ! podman run --rm --network exchequer --secret exchequer_db_password \
    -e PGHOST=exchequer-db -e PGUSER=exchequer -e PGDATABASE=exchequer \
    -e PGPASSWORD_FILE=/run/secrets/exchequer_db_password \
    -v "$dir:/backups:ro,Z" \
    localhost/exchequer-backup:latest \
    exchequer-backup restore --replace "/backups/$name" "$max"; then
    die "failed; the API is stopped (systemctl --user start exchequer-api.service)"
fi
systemctl --user start exchequer-api.service
echo "the API is running again"
