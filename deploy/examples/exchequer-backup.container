# One database dump, started by exchequer-backup.timer. Runs
# deploy/exchequer-backup inside the postgres image, which has pg_dump.
[Unit]
Description=Exchequer database backup
Requires=exchequer-db.service
After=exchequer-db.service

[Container]
ContainerName=exchequer-backup
Image=docker.io/library/postgres:17
Network=exchequer.network
Secret=exchequer_db_password
Environment=PGHOST=exchequer-db PGUSER=exchequer PGDATABASE=exchequer
Environment=PGPASSWORD_FILE=/run/secrets/exchequer_db_password
# Example paths: where you installed the script, and the backup drive.
Volume=%h/.local/lib/exchequer/exchequer-backup:/usr/local/bin/exchequer-backup:ro
Volume=/mnt/backup/exchequer:/backups:Z
# Keep the newest 30 dumps.
Exec=exchequer-backup dump /backups 30

[Service]
Type=oneshot
