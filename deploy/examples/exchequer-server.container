# The API server. Published on localhost only; put a reverse proxy in front
# for anything else.
[Unit]
Description=Exchequer API
Requires=exchequer-db.service
After=exchequer-db.service

[Container]
ContainerName=exchequer-server
# The newest release (see deploy/README.md, "Updating").
Image=ghcr.io/honkeandpastrami/exchequer-server:latest
# podman-auto-update.timer pulls a new release and restarts the API on it.
AutoUpdate=registry
Network=exchequer.network
PublishPort=127.0.0.1:7438:7438
# Healthy once it answers /healthz and reaches the database (`podman ps`
# shows it); the unit counts as started only then, and three failures in a
# row restart it.
# Exec form: a plain string runs under /bin/sh, which the image doesn't have.
HealthCmd=["/exchequer-server", "healthcheck"]
HealthInterval=30s
HealthStartPeriod=60s
HealthOnFailure=kill
Notify=healthy
Secret=exchequer_db_password
Secret=exchequer_bootstrap_token
Environment=EXCHEQUER_BIND=0.0.0.0:7438
# The household's time zone: what "today" and a bank file's dates mean. The
# image has no time zone files; the server has the names built in.
Environment=TZ=America/New_York
Environment=DB_HOST=exchequer-db DB_USER=exchequer DB_NAME=exchequer
Environment=DB_PASSWORD_FILE=/run/secrets/exchequer_db_password
Environment=BOOTSTRAP_TOKEN_FILE=/run/secrets/exchequer_bootstrap_token
# Where people open the web app, through the reverse proxy: passkeys are bound
# to its host (design §10). Unset, passkey sign-in is off and only tokens work.
#Environment=EXCHEQUER_ORIGIN=https://books.example.org/exchequer/
# Optional: remote AI (docs/ai.md), a decision model on Azure AI Foundry. All
# three or none; the key is a podman secret.
#Secret=exchequer_remote_ai_key
#Environment=EXCHEQUER_REMOTE_AI_ENDPOINT=https://<resource>.services.ai.azure.com
#Environment=EXCHEQUER_REMOTE_AI_DEPLOYMENT=<deployment name>
#Environment=REMOTE_AI_KEY_FILE=/run/secrets/exchequer_remote_ai_key
# Optional: Tiingo, the first price source (design §3.4); without its key, the
# ECB's reference rates (no key) are the only one.
#Secret=exchequer_tiingo_api_key
#Environment=TIINGO_API_KEY_FILE=/run/secrets/exchequer_tiingo_api_key

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
