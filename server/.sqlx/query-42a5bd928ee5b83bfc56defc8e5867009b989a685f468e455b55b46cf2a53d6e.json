  "query": "UPDATE api_token new SET revoked_at = coalesce(new.revoked_at, now())\n           FROM api_token old WHERE new.id = old.id AND new.id = $1\n           RETURNING old.id, old.name, old.secret_hash, old.created_at, old.revoked_at",
