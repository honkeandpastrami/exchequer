# Build context for the Containerfile (podman reads this file too).
*
!server/
server/target/
server/.pgdata/
server/.env
# The image tag pins the toolchain; this file would make rustup download
# clippy and rustfmt during the build.
server/rust-toolchain.toml
!web/
web/node_modules/
web/build/
web/.svelte-kit/
